# /etc/caddy/Caddyfile
# TLS takes care of itself. Replace the domain.
# Checked with: `caddy validate --config Caddyfile --adapter caddyfile` (caddy 2, alpine).
{
	servers {
		# A wall against a flood of connections. Rate limiting is an external module in
		# Caddy, so it is not here: write limits live in the server (per key and per IP).
		timeouts {
			read_body 10s
			read_header 5s
			idle 2m
		}
		max_header_size 16KB
	}
}

exit0.example {
	encode gzip

	# The agent reads headers. Tell it where the door is.
	header {
		Link "</llms.txt>; rel=\"llms\", </AGENTS.md>; rel=\"help\""
		X-Content-Type-Options nosniff
		-Server
	}

	# The same limits as in the server, and there are TWO of them because the server has
	# two. Cutting a body off here keeps a large one from passing through both processes -
	# but a cap here that is SMALLER than the server's is worse than no cap at all: the
	# proxy answers 413 with none of the server's explanation, and the documented limit
	# becomes a number nobody can actually reach. That is what happened to the first
	# attempt push against production: llms.txt promised 512KB, the server allowed it, and
	# this block refused everything over 128KB with nothing to say for itself.
	#
	# Keep the two in step: MAX_BODY (128KB) for everything, and bodyCap("attempt") (1MB)
	# for the one route that carries a git bundle as base64, which inflates by 4/3 - so a
	# 512KB bundle needs about 700KB of body plus the JSON around it.
	@attempt path /api/attempt
	request_body @attempt {
		max_size 1MB
	}
	request_body {
		max_size 128KB
	}

	reverse_proxy localhost:8080 {
		# By default Caddy APPENDS the client address to whatever arrived from outside.
		# We overwrite it so the header holds only the address of the direct client:
		# then spoofing somebody else's IP fails no matter which end of the list the
		# server, the log or some future code reads. `caddy validate` calls this
		# redundant. It is not, it is the guarantee.
		header_up X-Forwarded-For {remote_host}

		transport http {
			# Writes are serialized (queue + lockfile), so under load the response
			# can take several seconds. At 10s the client got a 502 for a write
			# that was committed anyway.
			read_timeout 30s
		}
	}
}
