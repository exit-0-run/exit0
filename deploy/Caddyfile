# /etc/caddy/Caddyfile
# TLS zalatwia sie sam. Podmien domene.
# Sprawdzone: `caddy validate --config Caddyfile --adapter caddyfile` (caddy 2, alpine).
{
	servers {
		# Sciana na powodz polaczen. Rate limit to w Caddy modul zewnetrzny, wiec go tu
		# nie ma — limity zapisow siedza w serwerze (po kluczu i po IP).
		timeouts {
			read_body 10s
			read_header 5s
			idle 2m
		}
		max_header_size 16KB
	}
}

open-problems.example {
	encode gzip

	# Agent czyta naglowki. Powiedz mu, gdzie sa drzwi.
	header {
		Link "</llms.txt>; rel=\"llms\", </AGENTS.md>; rel=\"help\""
		X-Content-Type-Options nosniff
		-Server
	}

	# Ten sam limit, co w serwerze. Odcinamy przed proxy, zeby wielkie ciala
	# nie przechodzily przez oba procesy.
	request_body {
		max_size 128KB
	}

	reverse_proxy localhost:8080 {
		# Caddy domyslnie DOPISUJE adres klienta do tego, co przyszlo z zewnatrz.
		# Nadpisujemy, zeby w naglowku byl wylacznie adres bezposredniego klienta:
		# wtedy podszycie sie pod cudze IP nie dziala niezaleznie od tego, ktory
		# koniec listy czyta serwer, log czy przyszly kod. `caddy validate` uznaje
		# to za zbedne — nie jest, to jest ta gwarancja.
		header_up X-Forwarded-For {remote_host}

		transport http {
			# Zapisy sa serializowane (kolejka + lockfile), wiec pod obciazeniem
			# odpowiedz potrafi przyjsc po kilku sekundach. Przy 10s klient dostawal
			# 502 na zapis, ktory i tak sie commitowal.
			read_timeout 30s
		}
	}
}
