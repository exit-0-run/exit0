# /etc/systemd/system/exit0.service
# Do not copy this file by hand. deploy/install.sh renders the target version from it:
# it replaces ExecStart, PATH, PORT, User, WorkingDirectory, ReadWritePaths and Documentation.
#   sudo deploy/install.sh
#   systemctl status exit0

[Unit]
Description=exit0 registry
Documentation=file:///srv/exit0/deploy/RUNBOOK.md
After=network.target

[Service]
Type=simple
User=exit0
WorkingDirectory=/srv/exit0

# The server runs `node scripts/build.mjs` and `git` BY NAME, not by path. The unit's
# default PATH holds neither /opt/... nor nvm, so without this line every write ends in
# ENOENT while reads keep working: the failure looks like a healthy server.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PORT=8080
# Public traffic comes in only through Caddy, from deploy/Caddyfile.
Environment=HOST=127.0.0.1
# This unit has a proxy in front of it and the proxy overwrites X-Forwarded-For. Without
# that, all traffic lands in one ::ffff:127.0.0.1 bucket and the per-IP limit chokes the deploy.
Environment=TRUST_PROXY=1
# Where a reader can browse the signed record: a base URL the problem's file path is
# appended to. Empty means no links, which is right for a registry nobody publishes.
# install.sh fills it from SOURCE_URL when it is given, and leaves it empty otherwise.
Environment=SOURCE_URL=
# Pushed code does NOT live in the registry: it lives in a second, bare repository beside
# it, and an attempt is an ordinary branch there. ATTEMPTS_DIR is where that repository is,
# ATTEMPTS_URL is the clone URL a verifier fetches from and ATTEMPTS_BROWSE the base of a
# web view of it. install.sh fills all three; the server derives ATTEMPTS_DIR from the
# working directory when it is empty. The URLs are never guessed from one another - turning
# an ssh clone URL into an https browse URL is host-specific string surgery that is wrong
# the first time somebody is not on GitHub - so an empty value means the field is simply
# absent rather than misleading.
Environment=ATTEMPTS_DIR=
Environment=ATTEMPTS_URL=
Environment=ATTEMPTS_BROWSE=
ExecStart=/usr/bin/node scripts/server.mjs
Restart=always
RestartSec=2

# A write is build + commit. SIGTERM should close the queue, not cut it off halfway.
KillSignal=SIGTERM
TimeoutStopSec=15

# Deliberately WITHOUT an ExecStartPre running `build.mjs --check`: in this server an
# inconsistent repo means read-only mode (503 on writes, reads work), not a process exit.
# That gate in ExecStartPre plus Restart=always would give a restart loop, not a diagnosis.

# The server runs `git` and `node`, writes only to its own directory, listens on a
# port > 1024 and needs not a single capability.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
# Registry content is public, but .state/ip.json holds counters keyed by client addresses.
# On a shared host there is no reason for everyone to be able to read them.
UMask=0027
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# TWO paths, and the second one is not optional. ProtectSystem=strict makes the whole
# filesystem read-only apart from what is named here, so leaving the attempts repository
# out means every push fails with EROFS - a storage error on a route that looks like it
# should only ever touch git.
ReadWritePaths=/srv/exit0 /srv/exit0-attempts.git
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
