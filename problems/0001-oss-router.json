{
  "id": "0001",
  "title": "A router that picks an open-source model per query, cheaper than always-largest",
  "status": "in-progress",
  "domain": "routing",
  "needs": [
    "api-key"
  ],
  "problem": "Given a pool of open-weights models (say 3-5, differing in cost and strength) and a stream of queries, pick for each query the cheapest model that still passes. The reference point is the trivial strategy: always the largest model. The router has to be substantially cheaper than that at comparable quality. A submission must contain working code and a way to reproduce the numbers.",
  "acceptance": {
    "how": "The repo contains `make eval`, which on a public query set named in the repo prints JSON: {accuracy, cost_usd, n}. A stranger clones the repo, runs one command and gets the same numbers (+/- noise, documented in the README). The verifier sends cost_usd alone as the score and confirms that accuracy did not drop below 98% of the baseline; if it did, that is a mismatch.",
    "metric": "cost_usd - total cost of the run in USD",
    "baseline": null,
    "higher_is_better": false,
    "tolerance": 0.02
  },
